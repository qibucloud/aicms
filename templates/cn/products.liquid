<div class="row">
    <div class="col-lg-12">
        <h1>{{ title }}</h1>
        <p class="lead">{{ description }}</p>

        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">搜索产品</h5>
                <form method="get" class="row g-2">
                    <div class="col-md-6">
                        <input type="text" name="keyword" class="form-control" placeholder="搜索关键词..." value="{{ keyword }}">
                    </div>
                    <div class="col-md-4">
                        <input type="text" name="category" class="form-control" placeholder="分类..." value="{{ category }}">
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">搜索</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="row">
            {% for product in products %}
                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">{{ product.name }}</h5>
                            <p class="card-text">{{ product.description }}</p>
                            <p class="card-text">
                                <strong>分类：</strong> {{ product.category }}<br>
                                <strong>SKU：</strong> {{ product.sku }}
                            </p>
                            <h6 class="text-primary">¥ {{ product.price }}</h6>
                        </div>
                        <div class="card-footer">
                            <button class="btn btn-sm btn-primary w-100">加入购物车</button>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        {% if products.size == 0 %}
            <div class="alert alert-info" role="alert">
                没有找到符合条件的产品。
            </div>
        {% endif %}

        <div class="mt-4">
            {% include 'pagination' %}
        </div>
    </div>
</div>
